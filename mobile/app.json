{
  "expo": {
    "name": "相悦",
    "slug": "mutual",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "site.jianjiange.mutual"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1512",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "site.jianjiange.mutual"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-secure-store",
      "expo-font",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "用来算你和推荐对象之间的大致距离。我们只保留一个约 5 公里的网格，不记录精确位置。"
        }
      ]
    ],
    "scheme": "mutual",
    "experiments": {
      "baseUrl": "/app"
    }
  }
}
