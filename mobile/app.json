{
  "expo": {
    "name": "相悦",
    "slug": "mutual",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "site.jianjiange.mutual"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#A32E4E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "site.jianjiange.mutual"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-secure-store",
      "expo-font",
      "expo-asset"
    ],
    "scheme": "mutual",
    "experiments": {
      "baseUrl": "/app"
    }
  }
}
